---
// The footer IS a -- comment: a quiet page map plus the identity loop
// (GitHub / X / CMC) shared with the product sites.
const year = new Date().getFullYear();
---

<footer class="border-t border-border px-6 py-12">
  <div class="mx-auto flex max-w-4xl flex-col items-center gap-6 text-center">
    {/* page map */}
    <nav class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm text-text-muted">
      <a href="/#projects" class="transition-colors hover:text-text">Projects</a>
      <a href="/#how" class="transition-colors hover:text-text">How we build</a>
      <a href="/#contact" class="transition-colors hover:text-text">Contact</a>
      <a href="/privacy" class="transition-colors hover:text-text">Privacy</a>
      <a href="/terms" class="transition-colors hover:text-text">Terms</a>
    </nav>

    {/* the identity loop */}
    <nav class="flex items-center gap-5">
      <a
        href="https://github.com/ahmlvs"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="AAA Devs on GitHub"
        class="text-text-muted transition-colors hover:text-text"
      >
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true">
          <path d="M12 .5C5.37.5 0 5.87 0 12.5c0 5.3 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58 0-.29-.01-1.04-.02-2.05-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.33-1.76-1.33-1.76-1.09-.74.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.49.99.11-.78.42-1.3.76-1.6-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.11-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 3-.4c1.02 0 2.05.14 3 .4 2.29-1.55 3.3-1.23 3.3-1.23.65 1.66.24 2.88.12 3.18.77.84 1.23 1.91 1.23 3.22 0 4.61-2.8 5.62-5.48 5.92.43.37.81 1.1.81 2.22 0 1.61-.01 2.9-.01 3.29 0 .32.21.7.82.58A12 12 0 0 0 24 12.5C24 5.87 18.63.5 12 .5z" />
        </svg>
      </a>
      <a
        href="https://x.com/ahmlvs"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="AAA Devs on X"
        class="text-text-muted transition-colors hover:text-text"
      >
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true">
          <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24h-6.657l-5.214-6.817-5.966 6.817H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
        </svg>
      </a>
      <a
        href="https://coinmarketcap.com/community/profile/ahmlvs/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="AAA Devs on CoinMarketCap"
        class="text-text-muted transition-colors hover:text-text"
      >
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true">
          <path d="M20.738 14.341c-.419.265-.912.298-1.286.087-.476-.27-.738-.898-.738-1.774v-2.618c0-1.264-.5-2.164-1.336-2.407-1.416-.413-2.482 1.32-2.882 1.972l-2.498 4.05v-4.95c-.028-1.14-.398-1.821-1.1-2.027-.466-.135-1.161-.081-1.837.953l-5.597 8.987A9.875 9.875 0 0 1 2.326 12c0-5.414 4.339-9.818 9.672-9.818 5.332 0 9.67 4.404 9.67 9.818.004.018.002.034.003.053.05 1.049-.29 1.883-.933 2.29zm3.08-2.34-.001-.055C23.787 5.353 18.497 0 11.997 0 5.48 0 .177 5.383.177 12c0 6.616 5.303 12 11.82 12 2.991 0 5.846-1.137 8.037-3.2.435-.41.46-1.1.057-1.541a1.064 1.064 0 0 0-1.519-.059 9.56 9.56 0 0 1-6.574 2.618c-2.856 0-5.425-1.263-7.197-3.268l5.048-8.105v3.737c0 1.794.696 2.374 1.28 2.544.584.17 1.476.054 2.413-1.468.998-1.614 2.025-3.297 3.023-4.88v2.276c0 1.678.672 3.02 1.843 3.68 1.056.597 2.384.543 3.465-.14 1.312-.828 2.018-2.354 1.944-4.193z" />
        </svg>
      </a>
    </nav>

    {/* the copyright line is, of course, a comment */}
    <p class="mono text-xs text-text-muted">
      -- © {year} AAA Devs · software studio, building in{" "}
      <span class="text-[#f7941d]">crypto</span> &amp; <span class="text-[#93cafa]">AI</span>
    </p>
  </div>
</footer>
