---
// Screen 1 of the ladder: "who is this?" Logo up top as the signature (small),
// the category line + the -- comment carry the message at page center, scroll
// hint pinned to the bottom. Brand name kept for crawlers via sr-only.
---

<section class="relative flex min-h-screen flex-col items-center overflow-hidden px-6">
  {/* subtle studio-red glow */}
  <div
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_center,_rgba(194,54,49,0.10)_0%,_transparent_70%)]"
  >
  </div>

  {/* the signature: logo query, small, at the top */}
  <div class="relative mt-14">
    <img src="/images/logo.svg" alt="SELECT 'AAA devs'; — the AAA Devs wordmark" class="h-auto w-56 max-w-full sm:w-72" />
  </div>

  {/* the message: category + comment, centered on the page */}
  <div class="relative flex flex-1 flex-col items-center justify-center pb-28 text-center">
    <h1 class="text-balance text-3xl font-semibold tracking-tight sm:text-4xl">
      <span class="sr-only">AAA Devs — </span>
      Software studio <span class="text-text-muted/60">&middot;</span> building in{" "}
      <span class="text-[#f7941d]">crypto</span> &amp; <span class="text-[#93cafa]">AI</span>
    </h1>

    <p class="mt-5 font-mono text-base text-text-muted sm:text-lg">-- AAA quality, indie size</p>
  </div>

  <a
    href="#projects"
    class="absolute inset-x-0 bottom-10 mx-auto w-6 animate-bounce"
    aria-label="View our projects"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="h-6 w-6 text-text-muted"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
    >
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
    </svg>
  </a>
</section>
