---
import "../styles/global.css";
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";
import interLatinUrl from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import monoLatinUrl from "@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url";

interface Props {
  title: string;
  description?: string;
}

const isProd = import.meta.env.PROD;

const {
  title,
  description = "AAA Devs is a two-product software studio: troniti (non-custodial TRON yield) and plainai (honest AI tools directory) — built in public, indie size.",
} = Astro.props;

// The entity layer: "AAA Devs" is the canonical name, "aaadevs" the one-word
// alternate (captures the navigational spelling); sameAs closes the identity
// loop with the same profiles the footer links.
const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "AAA Devs",
  alternateName: "aaadevs",
  url: "https://aaadevs.com",
  logo: "https://aaadevs.com/apple-touch-icon.png",
  description:
    "Software studio building its own products in crypto and AI: troniti (non-custodial TRON yield operator) and plainai (AI tools directory).",
  sameAs: [
    "https://x.com/ahmlvs",
    "https://github.com/ahmlvs",
    "https://coinmarketcap.com/community/profile/ahmlvs/",
  ],
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "AAA Devs",
  alternateName: "aaadevs",
  url: "https://aaadevs.com",
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://aaadevs.com/images/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="AAA Devs" />
    <meta property="og:url" content={`https://aaadevs.com${Astro.url.pathname}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@ahmlvs" />
    <meta name="twitter:creator" content="@ahmlvs" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://aaadevs.com/images/og-image.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#c23631" />
    <link rel="canonical" href={`https://aaadevs.com${Astro.url.pathname}`} />
    <link rel="preload" as="font" type="font/woff2" href={interLatinUrl} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={monoLatinUrl} crossorigin />
    <title>{title}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    {/* Google Analytics */}
    {isProd && (
      <>
        <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-XGBZ4DQ7TH"></script>
        <script is:inline>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', 'G-XGBZ4DQ7TH');
        </script>
      </>
    )}
  </head>
  <body class="min-h-screen antialiased">
    <slot />
  </body>
</html>
